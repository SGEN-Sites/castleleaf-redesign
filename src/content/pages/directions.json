 "h1": "Directions to CastleLeaf",
 "sections": [
  {
   "id": "",
   "blocks": [
    {
     "t": "h1",
     "html": "Directions to CastleLeaf"
    },
    {
     "t": "h2",
     "html": "Cannabis Dispensary located near Brighton, MA"
    },
    {
     "t": "h3",
     "html": "Location"
    },
    {
     "t": "p",
     "html": "100 Leo M Birmingham Pkwy<br>Brighton, MA 02135"
    },
    {
     "t": "embed",
     "src": "about:blank",
     "title": ""
    },
    {
     "t": "h2",
     "html": "<strong>How to Get to CastleLeaf Dispensary in Brighton, MA</strong>"
    },
    {
     "t": "p",
     "html": "Visiting CastleLeaf Dispensary is easy, whether you’re a local or traveling from nearby neighborhoods in Boston. This prime location makes us accessible to customers throughout Allston, Brookline, Cambridge, and Watertown, with major roadways and public transit options nearby. Whether you’re shopping for <a href=\"/categories/flower\">flower</a>, <a href=\"/categories/pre-rolls\">pre-rolls</a>, <a href=\"/categories/vaporizers\">vapes</a>, <a href=\"/categories/concentrates\">concentrates</a>, or <a href=\"/categories/edibles\">edibles</a>, CastleLeaf is your go-to Brighton dispensary with quality products and expert guidance."
    },
    {
     "t": "h3",
     "html": "🚗 <strong>Driving Directions</strong>"
    },
    {
     "t": "p",
     "html": "<strong>From Downtown Boston:</strong>"
    },
    {
     "t": "ul",
     "items": [
      {
       "blocks": [
        {
         "t": "p",
         "html": "Take <strong>Storrow Drive West</strong> toward Newton."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Exit onto <strong>Soldiers Field Road</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Continue onto <strong>Leo M Birmingham Parkway</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "CastleLeaf will be on your right—just past Western Avenue."
        }
       ]
      }
     ]
    },
    {
     "t": "p",
     "html": "<strong>From Cambridge:</strong>"
    },
    {
     "t": "ul",
     "items": [
      {
       "blocks": [
        {
         "t": "p",
         "html": "Head south on <strong>River Street</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Cross the <strong>Western Avenue Bridge</strong> into Allston/Brighton."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Turn right onto <strong>Leo M Birmingham Parkway</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "CastleLeaf is a short drive down on the left."
        }
       ]
      }
     ]
    },
    {
     "t": "p",
     "html": "<strong>From Brookline:</strong>"
    },
    {
     "t": "ul",
     "items": [
      {
       "blocks": [
        {
         "t": "p",
         "html": "Take <strong>Harvard Street</strong> north to <strong>Cambridge Street</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Turn left onto <strong>Market Street</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Continue to <strong>Leo M Birmingham Parkway</strong> and turn right."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "We’re located just past the Charles River."
        }
       ]
      }
     ]
    },
    {
     "t": "p",
     "html": "<strong>From I-90 (Mass Pike):</strong>"
    },
    {
     "t": "ul",
     "items": [
      {
       "blocks": [
        {
         "t": "p",
         "html": "Take Exit 131 (formerly Exit 17) toward <strong>Brighton/Cambridge</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Follow signs for <strong>Soldiers Field Road</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "Merge onto <strong>Leo M Birmingham Parkway</strong>."
        }
       ]
      }
     ]
    },
    {
     "t": "h3",
     "html": "🚇 <strong>Public Transit Directions</strong>"
    },
    {
     "t": "p",
     "html": "<strong>By MBTA Bus:</strong>"
    },
    {
     "t": "ul",
     "items": [
      {
       "blocks": [
        {
         "t": "p",
         "html": "Take <strong>Bus 70 or 86</strong> to the <strong>Western Ave @ Leo Birmingham Pkwy</strong> stop."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "It’s a short 3-minute walk to our front door."
        }
       ]
      }
     ]
    },
    {
     "t": "p",
     "html": "<strong>By Subway (Green Line):</strong>"
    },
    {
     "t": "ul",
     "items": [
      {
       "blocks": [
        {
         "t": "p",
         "html": "Take the <strong>Green Line B (Boston College)</strong> to <strong>Warren Street Station</strong>."
        }
       ]
      },
      {
       "blocks": [
        {
         "t": "p",
         "html": "From there, take <strong>Bus 86</strong> or a rideshare to reach us in about 10 minutes."
        }
       ]
      }
     ]
    },
    {
     "t": "h3",
     "html": ""
    },
    {
     "t": "h3",
     "html": "🚴 <strong>Bike or Walk</strong>"
    },
    {
     "t": "p",
     "html": "We’re bike-friendly and just minutes from the <strong>Charles River Bike Path</strong>, offering scenic access from Allston and Cambridge. Pedestrians can enjoy safe crosswalks and sidewalks along Western Ave and Leo Birmingham Parkway."
    },
    {
     "t": "h3",
     "html": ""
    },
    {
     "t": "h3",
     "html": "🅿️ Parking"
    },
    {
     "t": "p",
     "html": "Free onsite parking is available for your convenience."
    }
   ]
  }
 ]
}